# ==========================================
# Lumina Capital (lumina-quant v6.6.9)
# Environment Configuration Template
# ==========================================

# --- 1. LLM API Keys (At least one required for Agent Council) ---
# TIP: You can get a free Gemini API key from Google AI Studio (https://aistudio.google.com/)
# Gemini 2.5 Flash / 1.5 Pro works out-of-the-box for all 7 agent personas!
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY may also be a 1Password secret reference (op://vault/item/field). It is resolved with
# `op read` at first use and kept in memory only. See .env.op.sample for the `op run` form.
# LUMINA_LLM_PROVIDER=auto        # auto (Claude if its key resolves, else Gemini) | claude | gemini
# LUMINA_CLAUDE_MODEL=claude-opus-5-5
# LUMINA_CLAUDE_EFFORT=medium     # low | medium | high | xhigh | max

# --- 2. Market Data Providers (Optional - yfinance used by default without keys) ---
FRED_API_KEY=
FMP_API_KEY=

# --- 3. Neo4j Graph Database (Optional - for 3D Knowledge Graph & GraphRAG) ---
# Start container with: docker run -d -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/LuminaAI_2026_Secure neo4j:latest
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=LuminaAI_2026_Secure

# --- 4. Interactive Brokers (IBKR) Execution (Optional - Experimental Paper/Live) ---
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1

# --- 5. Notifications (Optional) ---
DISCORD_WEBHOOK_URL=
